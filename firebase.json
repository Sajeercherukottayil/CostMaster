{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "costmaster-ck",
          "appId": "1:479200434395:android:95e429a72a0c10c73d94fe",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "costmaster-ck",
          "configurations": {
            "android": "1:479200434395:android:95e429a72a0c10c73d94fe",
            "ios": "1:479200434395:ios:46b77db01dd481383d94fe",
