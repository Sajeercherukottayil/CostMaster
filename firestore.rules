rules_version = '2';

// Premium is granted only by the payment server in server/, whose Firebase
// Admin access bypasses these rules. Students may read their own
// entitlement, nothing else.
service cloud.firestore {
  match /databases/{database}/documents {
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
